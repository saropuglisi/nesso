# Copy to .env locally. Never commit API keys or your journal database.
NESSO_PORT=4180
NESSO_PROVIDER=openai-compatible
# Set an exact model returned by `ollama list` or by your provider.
NESSO_MODEL=
NESSO_BASE_URL=https://openrouter.ai/api/v1
NESSO_API_KEY=
NESSO_TIMEOUT_MS=240000
NESSO_DATA_DIR=./data
# Optional public-data sources. Keys and SEC contact remain server-side.
# SEC requires a real contact identifying this client (no API key required).
SEC_USER_AGENT=
# Obtain your free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# World Bank indicators need no key. Requests are made only when research is enabled.
# ollama: native /api/chat, schema in format.
# openai-compatible (LM Studio): http://127.0.0.1:1234/v1
# openai-compatible (remote): provider's HTTPS /v1 URL + API key.
# openai: https://api.openai.com/v1, Responses API + API key.
# No automatic fallback or silent transmission to a different provider.
